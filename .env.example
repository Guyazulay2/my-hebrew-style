# Required — get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — for real shopping search results (https://serpapi.com/)
SERPAPI_KEY=

# Database password (change in production)
POSTGRES_PASSWORD=mystylist_dev

# JWT secret (change in production!)
JWT_SECRET=change_me_in_production_use_random_string

# Frontend — URL of the backend API (empty = same origin via nginx)
VITE_API_URL=

# Allowed CORS origins (comma-separated). Must match the frontend URL.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Set to "production" to disable /api/docs
ENVIRONMENT=development
